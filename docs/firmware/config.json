{
  "name": "FXMICMOD",
  "sample_fx": "preset",
  "presets": [
    {
      "name": "Squeeze for backups",
      "comment": "Light autotune in C major. Squeeze and the backing vocals come in: the key's own triad on each note, in 2nd inversion around your voice.",
      "list": [
        {"effect": "autotune", "key": "C", "scale": "major", "speed": 0.7, "humanize": 0.2, "mix": 1},
        {"effect": "harmonizer", "chord": "key_triad", "inversion": 2, "octave": 0, "level": "$handle"}
      ]
    },
    {
      "name": "Night call",
      "level": 0.7,
      "comment": "A synth that sings your words, in the style of Kavinsky's Nightcall: hard autotune in C minor into a one-note vocoder. Squeeze for each note's chord in the key. Needs firmware 1.1.",
      "list": [
        {"effect": "autotune", "key": "C", "scale": "minor", "speed": 0.95, "humanize": 0, "mix": 1},
        {"effect": "vocoder", "waveform": "pulse", "bands": 11, "octave": 0, "breath": 0.8, "mix": 1, "gate": -60, "squeeze_chord": "key_triad"}
      ]
    },
    {
      "name": "Dream swirl",
      "level": 0.4,
      "comment": "A dreamy, swirling psych-pop vocal: a phaser that sweeps by itself, a tempo echo and a big room. Squeeze and the sweep gets faster, wider and deeper.",
      "list": [
        {"effect": "phaser", "frequency": {"block": "lfo", "waveform": "sine", "rate": {"block": "math", "operation": "constrained_lerp", "a": 0.25, "b": 0.8, "c": "$handle"}, "scale": {"block": "math", "operation": "constrained_lerp", "a": 300, "b": 1150, "c": "$handle"}, "offset": {"block": "math", "operation": "constrained_lerp", "a": 900, "b": 1850, "c": "$handle"}}, "feedback": {"block": "math", "operation": "constrained_lerp", "a": 0.4, "b": 0.85, "c": "$handle"}, "mix": {"block": "math", "operation": "constrained_lerp", "a": 0.25, "b": 0.5, "c": "$handle"}, "stages": 8},
        {"effect": "echo", "delay_ms": 330, "decay": 0.35, "mix": 0.22, "freq_shift": false, "max_delay_ms": 400},
        {"effect": "freeverb", "roomsize": 0.7, "damp": 0.4, "mix": 0.2}
      ]
    },
    {
      "name": "Squeeze monster",
      "comment": "From Adafruit's demo pack: the handle bends pitch from -12 to +12 semitones.",
      "level": 0.25,
      "list": [
        {"effect": "pitch_shift", "semitones": {"block": "math", "operation": "constrained_lerp", "a": -12, "b": 12, "c": "$handle"}, "mix": 1, "window": 1024, "overlap": 128},
        {"effect": "distortion", "drive": 0.6, "pre_gain": 36, "post_gain": -11, "mode": "overdrive", "soft_clip": true, "mix": 1},
        {"effect": "filter", "filter": {"mode": "low_pass", "frequency": 3500, "Q": 0.7071}, "mix": 1}
      ]
    }
  ],
  "samples": [
    {"file": "1.wav", "playmode": "auto"},
    {"file": "2.wav", "playmode": "auto"},
    {"file": "3.wav", "playmode": "auto"},
    {"file": "4.wav", "playmode": "auto"}
  ]
}
