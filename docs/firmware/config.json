{
  "name": "FXMICMOD",
  "sample_fx": "preset",
  "presets": [
    {
      "name": "Hard tune",
      "comment": "Robotic snap to the nearest note, with a little room.",
      "list": [
        {"effect": "autotune", "key": "C", "scale": "chromatic", "speed": 1.0, "humanize": 0.0, "mix": 1.0},
        {"effect": "freeverb", "roomsize": 0.4, "damp": 0.6, "mix": 0.25}
      ]
    },
    {
      "name": "Squeeze for backups",
      "comment": "Light autotune. Squeeze and the backing vocals come in: a sus2 chord in 2nd inversion around your voice. A short echo.",
      "level": 0.7,
      "list": [
        {"effect": "autotune", "key": "C", "scale": "chromatic", "speed": 0.7, "humanize": 0.2, "mix": 1},
        {"effect": "harmonizer", "chord": "sus2", "inversion": 2, "octave": 0, "level": "$handle"},
        {"effect": "echo", "delay_ms": 250, "decay": 0.1, "mix": 0.1, "freq_shift": false, "max_delay_ms": 500}
      ]
    },
    {
      "name": "Chipmunk space",
      "comment": "From Adafruit's demo pack.",
      "list": [
        {"effect": "filter", "filter": {"mode": "high_pass", "frequency": 200, "Q": 0.7071}, "mix": 1},
        {"effect": "granular_pitch_shift", "semitones": 8.0, "density": 3},
        {"effect": "echo", "max_delay_ms": 1200, "delay_ms": 750, "decay": 0.45, "mix": 0.35, "freq_shift": true},
        {"effect": "freeverb", "roomsize": 0.75, "damp": 0.55, "mix": 0.6}
      ]
    },
    {
      "name": "Squeeze monster",
      "comment": "From Adafruit's demo pack: the handle bends pitch from -12 to +12 semitones.",
      "list": [
        {"effect": "pitch_shift", "semitones": {"block": "math", "operation": "constrained_lerp", "a": -12, "b": 12, "c": "$handle"}, "mix": 1, "window": 1024, "overlap": 128},
        {"effect": "distortion", "drive": 0.6, "pre_gain": 12, "post_gain": -8, "mode": "overdrive", "soft_clip": true, "mix": 1},
        {"effect": "filter", "filter": {"mode": "low_pass", "frequency": 3500, "Q": 0.7071}, "mix": 1}
      ]
    }
  ],
  "samples": [
    {"file": "1.wav", "playmode": "oneshot"},
    {"file": "2.wav", "playmode": "oneshot"},
    {"file": "3.wav", "playmode": "hold"},
    {"file": "4.wav", "playmode": "startstop"}
  ]
}
