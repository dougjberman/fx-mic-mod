{
  "name": "T4C",
  "sample_fx": "preset",
  "presets": [
    {
      "name": "4.9 filter",
      "list": [
        {
          "effect": "filter",
          "filter": {
            "mode": "band_pass",
            "frequency": 1500,
            "Q": 1.2
          },
          "mix": 1
        }
      ]
    },
    {
      "name": "4.9 chorus",
      "list": [
        {
          "effect": "chorus",
          "max_delay_ms": 50,
          "delay_ms": 30,
          "voices": 3,
          "mix": 0.5
        }
      ]
    },
    {
      "name": "4.9 echo",
      "list": [
        {
          "effect": "echo",
          "max_delay_ms": 500,
          "delay_ms": 300,
          "decay": 0.4,
          "mix": 0.25,
          "freq_shift": false
        }
      ]
    },
    {
      "name": "4.9 reverb",
      "list": [
        {
          "effect": "freeverb",
          "roomsize": 0.5,
          "damp": 0.5,
          "mix": 0.4
        }
      ]
    }
  ],
